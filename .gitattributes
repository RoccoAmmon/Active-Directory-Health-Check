# Kodierungs-Erkennung für GitHub / Git
* text=auto eol=crlf

# Explizit UTF-8 für alle Textdateien
*.md text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.txt text eol=crlf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
